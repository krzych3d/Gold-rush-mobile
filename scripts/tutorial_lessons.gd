			step(["Złoto jest też twoim życiem", "Gold is also your life"], ["Ten licznik to twoje pieniądze i życie. Zakupy zmniejszają zapas. W prawdziwym meczu pusty skarbiec oznacza koniec, więc zostawiaj rezerwę.", "This counter is both your money and your life. Purchases reduce it. An empty vault ends a real match, so keep a reserve."], "gold"),
