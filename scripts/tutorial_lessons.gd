			observe(["Obserwuj zysk", "Watch the delivery"], ["Śledź najeźdźcę i licznik złota. Sam zakup nie zwiększa życia. Opłacalność najazdu zależy od rzeczywiście dostarczonego łupu.", "Follow the raider and gold counter. Hiring it does not increase your life. The raid pays only when loot is delivered."], "delivery")
