extends RefCounted
const L10n = preload("res://scripts/localization.gd")
const Rules = preload("res://scripts/balance_rules.gd")

static func text(copy) -> String:
	return str(copy[1 if L10n.language == "en" else 0]) if copy is Array else str(copy)

static func step(title: Array, body: Array, target: String = "arena", action: String = "next", setup: String = "", demo: String = "", goal: String = "") -> Dictionary:
	return {"title": title, "body": body, "target": target, "action": action, "setup": setup, "demo": demo, "goal": goal}

static func observe(title: Array, body: Array, goal: String, target: String = "actor") -> Dictionary:
	return step(title, body, target, "observe", "", "", goal)

static func play(title: Array, body: Array, demo: String) -> Dictionary:
	return step(title, body, "attack", "attack", "", demo)

static func definitions() -> Array:
	var runner: Dictionary = Rules.raider_stats(0, 1, false, 0)
	var carrier: Dictionary = Rules.raider_stats(1, 1, false, 0)
	var elf_cargo: int = Rules.raider_stats(1, 2, true, 0)["capacity"]
	return [
		{"id": "basics", "title": ["Podstawy i trzy alejki", "Basics and three lanes"], "race": 1, "steps": [
			step(["Uczysz się we własnym tempie", "Learn at your own pace"], ["To osobna plansza ćwiczebna. Nie ma odliczania, utraty meczu ani nagród EXP. Na początek poznasz grę goblinami, na przykładzie jednego stworka.", "This is a separate training board. There is no countdown, defeat or XP reward. Start with the Goblins and one raider."], "actor", "next", "preview"),
			step(["Górna alejka", "Top lane"], ["Kliknij ALEJKĘ 1. Następny zakup trafi właśnie na tę trasę. Jednostka ani pułapka na innej alejce nie obroni tej drogi.", "Tap LANE 1. Your next purchase goes on this route. A unit or trap on another lane cannot defend this one."], "lane:0", "lane:0"),
			step(["Środkowa alejka", "Middle lane"], ["Teraz kliknij ALEJKĘ 2. Podświetlenie planszy pokazuje wybraną trasę. Zmiana alejki nie przenosi już kupionych obiektów.", "Now tap LANE 2. The board highlights the selected route. Switching lanes does not move things you already bought."], "lane:1", "lane:1"),
