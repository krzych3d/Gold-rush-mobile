			step(["Cena kolejnego zakupu", "The next purchase price"], ["Spójrz na nową cenę zwiadowcy. Każdy kolejny tego samego typu w tej fali dodaje 20% ceny bazowej. Zmiana alejki tego nie zeruje; nowa fala tak.", "Look at the runner's new price. Each additional unit of the same type this wave adds 20% of base price. Switching lanes does not reset it; a new wave does."], "unit:0"),
