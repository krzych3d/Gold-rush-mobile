			play(["Chroń duży ładunek", "Protect the large cargo"], ["Uruchom przykład na pustej trasie. Większa pojemność oznacza większy pojedynczy łup, ale dłuższy powrót daje obronie więcej okazji do ataku.", "Start the example on an empty route. Greater capacity means a larger shipment, but a slower return gives defenses more opportunities."], "ordered"),
